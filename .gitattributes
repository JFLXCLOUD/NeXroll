# core.autocrlf is enabled for this repo, so anything git mistakes for text gets
# line-ending conversion on checkout. That would silently corrupt a font file.
# Mark the binary formats explicitly rather than relying on auto-detection.
*.ttf binary
*.otf binary
*.ttc binary
*.woff binary
*.woff2 binary

# Shell scripts run in the Linux image; a CRLF checkout on Windows would break
# them (sh reads the CR as part of each command).
*.sh text eol=lf
